{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "wood-spinder",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "index.html"
      },
      "tutorial":{
        "entry": "tutorial.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Example form",
        "description": "Show a simple form",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/example-form"
      },
      {
        "label": "New Game",
        "description": "New Game from JSON",
        "location":"subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-new-game"
      }
    ]
  },
  "forms": {
    "exampleForm": "/internal/form/example-submit",
    "createLevelForm":"/internal/form/create-level-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "wood_spinder_dev"
  }
}